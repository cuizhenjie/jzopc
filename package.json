{
  "name": "jizhi-ai-opc",
  "version": "0.1.0",
  "private": true,
  "description": "集智 AI OPC 社区官网 — 北京集美科技有限公司",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-hooks.mjs --test \"test/**/*.test.ts\"",
    "test:watch": "node --import ./scripts/test-hooks.mjs --test --watch \"test/**/*.test.ts\"",
    "db:types": "node scripts/gen-db-types.mjs",
    "verify": "node scripts/verify.mjs",
    "db:smoke": "node scripts/db-smoke.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "build:deploy": "NEXT_OUTPUT_STANDALONE=1 next build",
    "prepare:deploy": "node scripts/prepare-deploy.mjs",
    "start:deploy": "node deploy/server.js",
    "opc:content": "python3 scripts/build-opc-content.py",
    "opc:styles": "node scripts/build-opc-styles.mjs",
    "opc:hero": "node scripts/build-opc-hero.mjs",
    "opc:audit:design": "node scripts/opc-design-audit.mjs",
    "opc:audit:style": "node scripts/opc-style-conflict.mjs",
    "opc:audit:contrast": "node scripts/opc-contrast.mjs",
    "opc:audit:brand": "node scripts/opc-brand-audit.mjs",
    "opc:audit:responsive": "node scripts/responsive-audit.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@paper-design/shaders-react": "0.0.81",
    "@react-three/fiber": "^9.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "gsap": "^3.13.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.169.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
