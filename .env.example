# 集智 AI OPC 社区 · 环境变量样例
#
# 用法：复制为 .env.local（本地）或在部署平台的环境变量面板里逐项填写。
# 本文件只放占位符，不含任何真实密钥；真实值只放在 .env.local / 部署平台，且 .env* 已被 .gitignore 忽略。
#
# 留空时的通用行为：本项目**不要求**配置任何变量即可完整运行——
# 未配置 Supabase 时，数据访问层（src/lib/queries/index.ts）自动回落到本地种子数据
# （src/lib/data/seed.ts），站点所有页面照常渲染。

# ── Supabase（可选）────────────────────────────────────────────────────────
# Supabase 项目的 API 地址，形如 https://xxxx.supabase.co
# 留空 → getSupabaseAdmin() 返回 null，数据层全程走本地种子数据，不报错。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 的 anon 公开密钥（anon key），前端可见，可安全下发到浏览器。
# 留空 → 仅服务端 SUPABASE_SERVICE_ROLE_KEY 可用；两者都留空则回落种子数据。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 的 service_role 服务端高权限密钥，**绝不可暴露给浏览器**。
# 留空 → 自动降级使用 NEXT_PUBLIC_SUPABASE_ANON_KEY；两者都留空则回落种子数据。
#
# ⚠️ 安全红线：绝不能给它加 NEXT_PUBLIC_ 前缀。
#    NEXT_PUBLIC_ 会被 Next.js 内联进浏览器产物，一旦加上等同于把数据库最高权限公开。
#    仅在服务端使用（src/lib/supabase/server.ts 的 getSupabaseAdmin）。
SUPABASE_SERVICE_ROLE_KEY=

# ── 内部看板（可选）────────────────────────────────────────────────────────
# /ops/leads 内部线索看板的口令。请求需带上同名 cookie jz_ops_token。
# 留空 → tokenMatches() 恒为 false，看板不可访问（更安全的默认）。
# 设置时请使用足够随机的长口令，不要用可猜测的弱口令。
OPS_TOKEN=

# ── 通知与站点地址（可选）──────────────────────────────────────────────────
# 新线索通知用的企业 IM webhook 地址（形如飞书/钉钉群机器人地址）。
# 留空 → 不发送通知，线索仍然正常落库，不影响主流程。
LEAD_NOTIFY_WEBHOOK=

# 新线索通知的邮件收件人。与 RESEND_API_KEY 同时配置才会发邮件；
# 两者任一留空 → 只走 webhook，线索仍正常落库。
LEAD_NOTIFY_EMAIL_TO=

# Resend（https://resend.com）的 API Key，用于发送通知邮件。
# 留空 → 不发送邮件。⚠️ 这是服务端密钥，不要加 NEXT_PUBLIC_ 前缀。
RESEND_API_KEY=

# 邮件发件人地址。
# 留空 → 使用 Resend 测试账号 onboarding@resend.dev（只能发给自己，正式上线前必须配置）。
LEAD_NOTIFY_EMAIL_FROM=

# 站点对外访问地址，用于 canonical 链接、sitemap.xml、robots.txt 与分享卡片。
# 留空 → 回落到 http://localhost:3000（本地开发默认值，上线前必须改成正式域名）。
NEXT_PUBLIC_SITE_URL=
