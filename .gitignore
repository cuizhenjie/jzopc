# 依赖
node_modules/
.pnpm-store/
.pnp.*

# 构建产物
.next/
out/
dist/
build/
*.tsbuildinfo

# 环境变量（含密钥，绝不提交）
.env
.env.*
!.env.example

# 本地工具痕迹 / 临时产物
.umadev/
.screenshots/
.vercel/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Office 临时锁文件
~$*.docx
~$*.doc
~$*.xlsx

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# Isolated local UI verification output
.next-ui/
.next-opc/
.next-opc-build/
.next-opc-visual/
.playwright-mcp/
__pycache__/

# 裸机部署产物（由 pnpm prepare:deploy 生成）
deploy/

# 发布包（由 scripts/build-release.sh 生成）
release/

# 本地工具产物（会话/审计/视频代理，不属于站点源码）
.mimosa/
.video_agent/
webimages/
.zcode/
.v2c/
# oh-my-claudecode 会话交接产物（本地工具状态，不入库）
.omc/
.next-layout-refresh/
.next-ui-review/
.next-ui-final/
# 自定义 distDir 的本地构建产物（.next-traffic-ui 等），一网打尽
.next-*/
.next-traffic/

# 本地 Supabase CLI 链接凭据痕迹（含 credential_ref，绝不入库）
supabase/.temp/

# 个人 portfolio 发布脚本的工作目录（scripts/publish-portfolio.sh 生成）
.portfolio-src/
.portfolio-dist/
