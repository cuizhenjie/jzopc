# 安装到 /etc/jizhi.env，root:jizhi 0600；不要提交真实值。
# systemd 格式：KEY=value，无 export；含特殊字符的值使用双引号。
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=4000

# 下面三个值必须也在构建时注入；此处应与构建使用的值保持一致。
NEXT_PUBLIC_SITE_URL=https://www.jizhiai.net.cn
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅运行时使用，不能改成 NEXT_PUBLIC_ 前缀，也不要注入构建环境。
SUPABASE_SERVICE_ROLE_KEY=
# 选填：后台恢复主口令；留空关闭此通道，使用数据库管理员账号登录。
OPS_TOKEN=

# 选填：后台上传；浏览器须能访问 S3_ENDPOINT，CORS 允许正式域名。
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 选填：新线索通知。
LEAD_NOTIFY_WEBHOOK=
LEAD_NOTIFY_EMAIL_TO=
LEAD_NOTIFY_EMAIL_FROM=
RESEND_API_KEY=
