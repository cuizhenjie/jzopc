# Rocky 9 内网应用；由 bootstrap-rocky.sh 安装并替换 NODE_BIN。
[Unit]
Description=JIZHI website (Next.js standalone)
Documentation=https://gitlab.jimei.cn/jmtxl/jizhi-website
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jizhi
Group=jizhi
# 每次重启解析 current 链接，切换版本后加载新的程序。
WorkingDirectory=/data/app-home/jizhi/current
# root 读取 0600 环境文件后传入子进程，不要求应用用户读取文件。
EnvironmentFile=/etc/jizhi.env
# EnvironmentFile 的同名变量优先。IPv4 LAN 访问由 firewalld 限制。
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=4000
ExecStart=/usr/bin/node /data/app-home/jizhi/current/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jizhi

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# V8 JIT 需要可执行内存。
MemoryDenyWriteExecute=false
# Next 的 ISR 和图片缓存需要可写；真实发布目录由发布脚本交给 jizhi。
ReadWritePaths=/data/app-home/jizhi

[Install]
WantedBy=multi-user.target
